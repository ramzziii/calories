# Copy this to .env and fill in real values. .env is gitignored — never
# commit real values.
#
# EXPO_PUBLIC_ vars get inlined into the app bundle at build time, so
# only put things here that are safe to ship in a client app (the
# Supabase anon/publishable key is designed for exactly this — it's
# scoped by Row Level Security, not secrecy). True secrets, like the
# OpenAI API key used by supabase/functions/analyze-meal, never belong
# in this file — set those with `supabase secrets set` instead.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-OR-PUBLISHABLE-KEY
