    "eslint-config-universe": "^13.0.0",
    "eslint-plugin-jest": "^28.6.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
