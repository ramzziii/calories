    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{ts,tsx,js,json}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "maestro test e2e/flows",
    "prepare": "husky install"
  },
  "dependencies": {
    "@kingstinct/react-native-healthkit": "^14.0.2",
